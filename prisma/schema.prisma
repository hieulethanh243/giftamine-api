generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Plan {
  FREE
  PREMIUM
}

model User {
  id String @id @default(uuid())

  email    String  @unique
  password String?

  name      String?
  avatarUrl String?

  plan Plan @default(FREE)

  provider   String?
  providerId String?

  partnerId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
